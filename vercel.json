{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/tools",
      "destination": "https://tools-system.vercel.app/tools"
    },
    {
      "source": "/tools/:path*",
      "destination": "https://tools-system.vercel.app/tools/:path*"
    },
    {
      "source": "/docs-api",
      "destination": "https://tools-system.vercel.app/docs-api"
    },
    {
      "source": "/docs-api/:path*",
      "destination": "https://tools-system.vercel.app/docs-api/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://tools-system.vercel.app/api/v1/:path*"
    },
    {
      "source": "/methodology",
      "destination": "https://tools-system.vercel.app/methodology"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://tools-system.vercel.app/_next/:path*"
    }
  ]
}
