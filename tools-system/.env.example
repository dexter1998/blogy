# Public site URL (used in docs examples). For Vercel set this to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API mode: "open" (no key required, anonymous rate-limited) | "key" (requires x-api-key)
API_AUTH_MODE=open

# Comma-separated demo API keys for the "key" mode. Replace with DB lookup in production.
API_KEYS=

# Per-IP requests per minute for anonymous access
RATE_LIMIT_PER_MIN=30

# Cache TTL (seconds) for scrape results keyed by URL
CACHE_TTL_SECONDS=900

# Per-scrape network timeout (ms)
SCRAPE_TIMEOUT_MS=8000

# Optional: User-Agent for outbound scraping
SCRAPE_USER_AGENT=BlogyToolsBot/1.0 (+https://blogy.in/tools)
