# Public site URL (used in docs examples). For Vercel set this to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API mode: "open" (no key required, anonymous rate-limited) | "key" (requires x-api-key)
API_AUTH_MODE=open

# Comma-separated demo API keys for the "key" mode. Replace with DB lookup in production.
API_KEYS=

# Per-IP requests per minute for anonymous access
RATE_LIMIT_PER_MIN=30

# Cache TTL (seconds) for scrape results keyed by URL
CACHE_TTL_SECONDS=900

# Per-scrape network timeout (ms)
SCRAPE_TIMEOUT_MS=8000

# Optional: User-Agent for outbound scraping
SCRAPE_USER_AGENT=BlogyToolsBot/1.0 (+https://blogy.in/tools)

# Optional: OpenPageRank API key (free, sign up at https://www.openpagerank.com/api).
# When set, the authority signal includes a global PageRank-style reading.
# Pipeline degrades gracefully when this is missing — Common Crawl + on-page
# signals still produce a Blogy-native score.
OPR_API_KEY=

# Optional: WhoisXML API key (https://whois.whoisxmlapi.com/).
# Used as a fallback for the WHOIS/RDAP tool when RDAP returns no record.
# A default free-tier key is bundled — override per-deployment if you have your own.
WHOISXML_API_KEY=
